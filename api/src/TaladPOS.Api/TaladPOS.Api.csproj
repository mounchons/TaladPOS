<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Feeds the controllers' <summary> docs into Swagger (T077). CS1591
         ("missing XML comment") is suppressed because only the endpoints are
         meant to be documented, not every public DTO member. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.10">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TaladPOS.Application\TaladPOS.Application.csproj" />
    <ProjectReference Include="..\TaladPOS.Infrastructure\TaladPOS.Infrastructure.csproj" />
    <ProjectReference Include="..\TaladPOS.Domain\TaladPOS.Domain.csproj" />
  </ItemGroup>

</Project>
